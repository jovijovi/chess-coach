{
  "name": "chess-coach-workspace",
  "version": "0.2.0-rc.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run package && npm run docs:build && npm test && npm run test:browser",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:preview": "npm run docs:build && vite preview --config docs/vite.config.mjs",
    "install:local": "node scripts/install-local.mjs",
    "stop": "node plugins/chess-coach/dist/control.js stop",
    "open": "node plugins/chess-coach/dist/control.js open",
    "format": "prettier --write .",
    "package": "node scripts/package.mjs",
    "doctor": "node plugins/chess-coach/dist/control.js doctor",
    "clean:runtime": "node plugins/chess-coach/dist/control.js clean-runtime"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "chess.js": "1.4.0",
    "react": "19.3.0",
    "react-chessboard": "5.12.1",
    "react-dom": "19.3.0",
    "stockfish": "18.0.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jovijovi/chess-coach.git"
  }
}
